/* MissionForge host theme: base, type scale and layout helpers (UI Toolkit USS).
   Tokens (palette, type sizes, spacing, radii, motion) come ONLY from Tokens.uss, generated from tokens.json.
   Do not fork the theme: a screen adds layout rules in its own sheet and uses the classes here and in
   UI/Components/*.uss (see UI/DESIGN_SYSTEM.md). Every value is a game_value art choice (VISUAL_TARGET 3.1).

   Reference canvas 1920 x 1080 (PanelSettings ScaleWithScreenSize, match 0.5), read across a room.
   Faces: Oxanium for display/h1/h2 (sentence case), IBM Plex Sans for everything else (its default digits are
   tabular: every figure advances 600 units), IBM Plex Mono only for .mf-code (room codes, identifiers).
   USS subset: no calc(), line-height, box-shadow, backdrop blur, outline or dashed borders. Shadows are 9-slice
   sprites (Surfaces.uss), glass samples a blurred scene copy (MfGlassPanel), patterns are drawn by Painter2D. */

:root {
    -unity-font-definition: var(--mf-font-body);
    color: var(--mf-ceramic);
    font-size: var(--mf-fs-body);
}

/* ---------- layout helpers ---------- */
.mf-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mf-row { flex-direction: row; }
.mf-col { flex-direction: column; }
.mf-grow { flex-grow: 1; }
.mf-center { align-items: center; justify-content: center; }
.mf-between { justify-content: space-between; }
.mf-align-center { align-items: center; }
.mf-align-end { align-items: flex-end; }
.mf-wrap { flex-wrap: wrap; }
.mf-gap-right { margin-right: var(--mf-sp-gutter); }
.mf-gap-bottom { margin-bottom: var(--mf-sp-gutter); }
.mf-gap-top { margin-top: var(--mf-sp-gutter); }
.mf-hidden { display: none; }
.mf-rtl .mf-row { flex-direction: row-reverse; }

/* A screen fills the panel inside the 5 % TV-safe margin and enters with the screen motion token. */
.mf-screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    padding: 136px var(--mf-sp-safe-x) var(--mf-sp-safe-y) var(--mf-sp-safe-x);
    opacity: 0;
    translate: 0 16px;
    transition-property: opacity, translate;
    transition-duration: var(--mf-dur-screen);
    transition-timing-function: ease-in-out-cubic;
}
.mf-screen--bare { padding: var(--mf-sp-safe-y) var(--mf-sp-safe-x) var(--mf-sp-safe-y) var(--mf-sp-safe-x); }
.mf-screen--shown { opacity: 1; translate: 0 0; }

/* ---------- type scale (VISUAL_TARGET 3.1 table) ---------- */
.mf-display, .mf-h1, .mf-h2, .mf-h3, .mf-kpi, .mf-body, .mf-label, .mf-meta, .mf-code { margin: 0; padding: 0; }
.mf-display { -unity-font-definition: var(--mf-font-display); font-size: var(--mf-fs-display); color: var(--mf-ceramic); letter-spacing: 0; }
.mf-h1 { -unity-font-definition: var(--mf-font-display); font-size: var(--mf-fs-h1); color: var(--mf-ceramic); letter-spacing: 0; }
.mf-h2 { -unity-font-definition: var(--mf-font-display); font-size: var(--mf-fs-h2); color: var(--mf-ceramic); letter-spacing: 0; }
.mf-h3 { -unity-font-definition: var(--mf-font-body-bold); font-size: var(--mf-fs-h3); color: var(--mf-ceramic); letter-spacing: 0; }
/* Key numbers: Plex Sans semibold, tabular by default. --l is the 72 px hero size. */
.mf-kpi { -unity-font-definition: var(--mf-font-body-bold); font-size: var(--mf-fs-kpi); color: var(--mf-ceramic); }
.mf-kpi--l { font-size: var(--mf-fs-kpi-l); }
.mf-body { -unity-font-definition: var(--mf-font-body); font-size: var(--mf-fs-body); color: var(--mf-ceramic); white-space: normal; }
.mf-label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); white-space: normal; }
.mf-label--strong { color: var(--mf-ceramic); -unity-font-definition: var(--mf-font-body-bold); }
/* Meta: dense heads and ticks only, never essential. */
.mf-meta { -unity-font-definition: var(--mf-font-body); font-size: var(--mf-fs-meta); color: var(--mf-muted); }
/* Units render at ~70 % of body (22 px) in Muted; in C# prefer MfText.WithUnit (rich text keeps the baseline and the thin space). */
.mf-unit { -unity-font-definition: var(--mf-font-body-medium); font-size: 22px; color: var(--mf-muted); margin: 0 0 0 4px; padding: 0; }
/* Plex Mono is restricted to code-like identifiers. Capitals for identifiers of <= 3 words, tracked +4 %. */
.mf-code { -unity-font-definition: var(--mf-font-mono-bold); color: var(--mf-ceramic); letter-spacing: 1px; }
.mf-caps { letter-spacing: 1px; }
.mf-body--dim { color: var(--mf-muted); }
.mf-text-good { color: var(--mf-meets); }
.mf-text-warn { color: var(--mf-marginal); }
.mf-text-bad { color: var(--mf-fails); }
.mf-text-accent { color: var(--mf-signal); }
.mf-text-forge { color: var(--mf-sunlight); }
.mf-text-muted { color: var(--mf-muted); }
.mf-rtl .mf-body, .mf-rtl .mf-label, .mf-rtl .mf-h1, .mf-rtl .mf-h2, .mf-rtl .mf-h3 { -unity-text-align: upper-right; }

/* ---------- legacy aliases (screens owned by later tasks still use them; they now map onto the scale) ---------- */
.mf-caption { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); margin: 0; padding: 0; }
.mf-num { -unity-font-definition: var(--mf-font-body-bold); font-size: 40px; color: var(--mf-ceramic); margin: 0; padding: 0; }
.mf-num--small { font-size: 28px; -unity-font-definition: var(--mf-font-body-medium); }
.mf-mono { -unity-font-definition: var(--mf-font-mono); }
/* A region reserved for a later task: a designed loading state, not a debug label. */
.mf-region {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--mf-ceramic-10);
    border-radius: var(--mf-radius-card);
    background-color: var(--mf-console-60);
    padding: var(--mf-sp-5);
    justify-content: flex-end;
}
.mf-region__label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); margin: 0; padding: 0; white-space: normal; }

/* ---------- persistent chrome (top navigation lives in Components/Navigation.uss) ---------- */
.mf-chrome { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mf-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--mf-space); opacity: 1; }

/* ---------- high contrast (applied on the panel root as .mf-hc): no imagery behind text ---------- */
.mf-hc .mf-label, .mf-hc .mf-meta, .mf-hc .mf-unit, .mf-hc .mf-body--dim, .mf-hc .mf-caption { color: var(--mf-ceramic); }

/* ---------- 200 % text (applied on the panel root as .mf-text-200): every token size doubles ---------- */
.mf-text-200 {
    --mf-fs-display: 192px;
    --mf-fs-h1: 128px;
    --mf-fs-h2: 88px;
    --mf-fs-h3: 72px;
    --mf-fs-kpi: 112px;
    --mf-fs-kpi-l: 144px;
    --mf-fs-body: 64px;
    --mf-fs-label: 48px;
    --mf-fs-meta: 40px;
}

/* ---------- motion base (MfMotion.Enter removes .mf-enter after the stagger delay) ---------- */
.mf-motion { transition-property: opacity, translate, scale; transition-duration: var(--mf-dur-enter); transition-timing-function: ease-out-cubic; }
.mf-enter { opacity: 0; translate: 0 16px; }
