{
  "$schema_note": "MissionForge design tokens v1. Single source for the host (Unity UI Toolkit) and the phone (React) clients. Every value is an artistic game_value from orchestration/VISUAL_TARGET.md 3.1 and assets/media/style/STYLE_GUIDE.md; none is a physical measurement. Unity: MissionForge > Design System > Generate Token USS writes UI/Theme/Tokens.uss from this file; the EditMode test TokenSyncTests fails if they disagree.",
  "version": 1,
  "value_type": "game_value",
  "reference_canvas_px": { "value": [1920, 1080], "value_type": "game_value" },

  "color": {
    "space":    { "value": "#071522", "value_type": "game_value", "use": "background, scrims, text on light fills" },
    "console":  { "value": "#112B40", "value_type": "game_value", "use": "opaque surfaces, glass tint base" },
    "ocean":    { "value": "#176887", "value_type": "game_value", "use": "decorative accent, identity chips; never small text" },
    "ceramic":  { "value": "#E8EEF0", "value_type": "game_value", "use": "main text, primary button plate" },
    "signal":   { "value": "#55C5CD", "value_type": "game_value", "use": "selection, focus, series 1; never success alone" },
    "sunlight": { "value": "#FFCE83", "value_type": "game_value", "use": "highlights, critical path outline, series 2" },
    "muted":    { "value": "#B6C7D3", "value_type": "game_value", "use": "secondary text, units" },
    "meets":    { "value": "#77D6A1", "value_type": "game_value", "use": "status Meets (check in circle, solid)" },
    "marginal": { "value": "#FFD166", "value_type": "game_value", "use": "status Marginal (exclamation in triangle, 45 degree hatch)" },
    "fails":    { "value": "#FF8F8F", "value_type": "game_value", "use": "status Fails (cross in octagon, cross-hatch)" },
    "periwinkle": { "value": "#A5B4FC", "value_type": "game_value", "use": "series 3 (proposal; contrast on Console checked in evidence/T031/contrast.md)" },
    "rose":     { "value": "#F4A6C6", "value_type": "game_value", "use": "series 4 (proposal; contrast on Console checked in evidence/T031/contrast.md)" },
    "qr-light": { "value": "#FFFFFF", "value_type": "game_value", "use": "QR plate only; never text" }
  },

  "color_alpha": {
    "space-0":     { "base": "space",    "alpha": 0.00, "value_type": "game_value" },
    "space-40":    { "base": "space",    "alpha": 0.40, "value_type": "game_value", "use": "e1 shadow colour" },
    "space-60":    { "base": "space",    "alpha": 0.60, "value_type": "game_value" },
    "space-80":    { "base": "space",    "alpha": 0.80, "value_type": "game_value", "use": "text scrim" },
    "space-92":    { "base": "space",    "alpha": 0.92, "value_type": "game_value", "use": "e3 modal scrim" },
    "console-60":  { "base": "console",  "alpha": 0.60, "value_type": "game_value" },
    "console-76":  { "base": "console",  "alpha": 0.76, "value_type": "game_value" },
    "console-80":  { "base": "console",  "alpha": 0.80, "value_type": "game_value", "use": "e2 glass tint (72-80 %); 80 % keeps Muted text >= 4.5:1 over white cloud (evidence/T031/contrast.md)" },
    "console-88":  { "base": "console",  "alpha": 0.88, "value_type": "game_value", "use": "e1 card surface" },
    "ocean-24":    { "base": "ocean",    "alpha": 0.24, "value_type": "game_value" },
    "ocean-48":    { "base": "ocean",    "alpha": 0.48, "value_type": "game_value" },
    "ceramic-06":  { "base": "ceramic",  "alpha": 0.06, "value_type": "game_value" },
    "ceramic-10":  { "base": "ceramic",  "alpha": 0.10, "value_type": "game_value", "use": "e1 border, bar track" },
    "ceramic-16":  { "base": "ceramic",  "alpha": 0.16, "value_type": "game_value", "use": "e2 top highlight, dividers" },
    "ceramic-32":  { "base": "ceramic",  "alpha": 0.32, "value_type": "game_value" },
    "ceramic-56":  { "base": "ceramic",  "alpha": 0.56, "value_type": "game_value" },
    "signal-16":   { "base": "signal",   "alpha": 0.16, "value_type": "game_value" },
    "signal-32":   { "base": "signal",   "alpha": 0.32, "value_type": "game_value" },
    "signal-40":   { "base": "signal",   "alpha": 0.40, "value_type": "game_value", "use": "if-chosen ghost delta" },
    "signal-56":   { "base": "signal",   "alpha": 0.56, "value_type": "game_value" },
    "sunlight-16": { "base": "sunlight", "alpha": 0.16, "value_type": "game_value" },
    "sunlight-40": { "base": "sunlight", "alpha": 0.40, "value_type": "game_value" },
    "meets-16":    { "base": "meets",    "alpha": 0.16, "value_type": "game_value" },
    "meets-56":    { "base": "meets",    "alpha": 0.56, "value_type": "game_value" },
    "marginal-16": { "base": "marginal", "alpha": 0.16, "value_type": "game_value" },
    "fails-16":    { "base": "fails",    "alpha": 0.16, "value_type": "game_value" }
  },

  "font": {
    "display":        { "value": "Oxanium",        "weight": 700, "file": "oxanium-700.ttf",          "value_type": "game_value", "use": "titles and logo only, sentence case" },
    "display-medium": { "value": "Oxanium",        "weight": 600, "file": "oxanium-500.ttf",          "value_type": "game_value", "note": "repo ships 500/700/800 instances; 500 stands in for 600" },
    "display-heavy":  { "value": "Oxanium",        "weight": 800, "file": "oxanium-800.ttf",          "value_type": "game_value" },
    "body":           { "value": "IBM Plex Sans",  "weight": 400, "file": "ibm-plex-sans-400.ttf",    "value_type": "game_value", "note": "default digits are tabular (all 600 units), verified in evidence/T031/fonts.md" },
    "body-medium":    { "value": "IBM Plex Sans",  "weight": 500, "file": "ibm-plex-sans-500.ttf",    "value_type": "game_value" },
    "body-bold":      { "value": "IBM Plex Sans",  "weight": 600, "file": "ibm-plex-sans-600.ttf",    "value_type": "game_value" },
    "mono":           { "value": "IBM Plex Mono",  "weight": 400, "file": "IBMPlexMono-Regular.ttf",  "value_type": "game_value", "use": "mf-code only: room codes, identifiers" },
    "mono-bold":      { "value": "IBM Plex Mono",  "weight": 600, "file": "IBMPlexMono-SemiBold.ttf", "value_type": "game_value", "use": "mf-code only" }
  },

  "type": {
    "display": { "size_px": 96, "line_height": 1.10, "font": "display",        "value_type": "game_value", "use": "title lockup, end-screen hero" },
    "h1":      { "size_px": 64, "line_height": 1.15, "font": "display",        "value_type": "game_value", "use": "screen title" },
    "h2":      { "size_px": 44, "line_height": 1.20, "font": "display",        "value_type": "game_value", "use": "panel title" },
    "h3":      { "size_px": 36, "line_height": 1.25, "font": "body-bold",      "value_type": "game_value", "use": "card title, option name" },
    "kpi":     { "size_px": 56, "line_height": 1.00, "font": "body-bold",      "value_type": "game_value", "use": "key numbers (tabular)" },
    "kpi-l":   { "size_px": 72, "line_height": 1.00, "font": "body-bold",      "value_type": "game_value", "use": "hero key numbers (tabular)" },
    "body":    { "size_px": 32, "line_height": 1.35, "font": "body",           "value_type": "game_value", "use": "default" },
    "label":   { "size_px": 24, "line_height": 1.30, "font": "body-medium",    "value_type": "game_value", "use": "minimum for any text a player must read" },
    "meta":    { "size_px": 20, "line_height": 1.30, "font": "body",           "value_type": "game_value", "use": "dense table heads and ticks only, never essential" },
    "unit_scale":       { "value": 0.70, "value_type": "game_value", "use": "units at 70 % size in Muted, thin space before" },
    "caps_tracking_em": { "value": 0.04, "value_type": "game_value", "use": "capitals only for identifiers of 3 words or fewer" }
  },

  "space": {
    "1": { "value_px": 4,  "value_type": "game_value" },
    "2": { "value_px": 8,  "value_type": "game_value" },
    "3": { "value_px": 12, "value_type": "game_value" },
    "4": { "value_px": 16, "value_type": "game_value" },
    "5": { "value_px": 24, "value_type": "game_value" },
    "6": { "value_px": 32, "value_type": "game_value" },
    "7": { "value_px": 48, "value_type": "game_value" },
    "8": { "value_px": 64, "value_type": "game_value" },
    "9": { "value_px": 96, "value_type": "game_value" },
    "panel-padding": { "value_px": 32, "value_type": "game_value" },
    "gutter":        { "value_px": 24, "value_type": "game_value" },
    "safe-x":        { "value_px": 96, "value_type": "game_value", "use": "5 % of 1920" },
    "safe-y":        { "value_px": 54, "value_type": "game_value", "use": "5 % of 1080" }
  },

  "radius": {
    "control": { "value_px": 8,   "value_type": "game_value" },
    "card":    { "value_px": 16,  "value_type": "game_value" },
    "panel":   { "value_px": 24,  "value_type": "game_value" },
    "pill":    { "value_px": 999, "value_type": "game_value" }
  },

  "elevation": {
    "e0": { "surface": "scene",                                                    "value_type": "game_value" },
    "e1": { "surface": "console-88", "border": "ceramic-10", "shadow_px": 24, "shadow_color": "space-40", "sprite": "UI/Sprites/mf-shadow-e1.png", "value_type": "game_value" },
    "e2": { "surface": "glass: blurred scene + console-80", "highlight": "ceramic-16", "shadow_px": 32, "sprite": "UI/Sprites/mf-shadow-e2.png", "value_type": "game_value" },
    "e3": { "surface": "space-92 scrim + e2 panel", "shadow_px": 48, "sprite": "UI/Sprites/mf-shadow-e3.png", "value_type": "game_value" },
    "e4": { "surface": "toast, console opaque", "shadow_px": 40, "sprite": "UI/Sprites/mf-shadow-e4.png", "value_type": "game_value" }
  },

  "motion": {
    "micro":     { "ms": 120,  "curve": "ease-out-cubic",    "value_type": "game_value", "use": "hover, press" },
    "state":     { "ms": 200,  "curve": "ease-out-cubic",    "value_type": "game_value", "use": "select, toggle, tab" },
    "enter":     { "ms": 320,  "curve": "ease-out-cubic",    "value_type": "game_value", "use": "panels, cards, toasts" },
    "exit":      { "ms": 220,  "curve": "ease-in-cubic",     "value_type": "game_value", "use": "panels, cards, toasts" },
    "screen":    { "ms": 600,  "curve": "ease-in-out-cubic", "value_type": "game_value", "use": "screen transitions" },
    "count":     { "ms": 1000, "curve": "ease-out-quart",    "value_type": "game_value", "use": "number count-up, tally growth (900-1200 ms)" },
    "pulse":     { "ms": 1600, "curve": "ease-in-out-sine",  "value_type": "game_value", "use": "timer warning, last 5 s only" },
    "celebrate": { "ms": 480,  "curve": "ease-out-back",     "value_type": "game_value", "use": "success moments only (<= 6 % overshoot)" },
    "stagger":   { "ms": 40, "max_items": 8,                 "value_type": "game_value" },
    "reduced":   { "ms": 150, "curve": "linear",             "value_type": "game_value", "use": "reduced motion: opacity fade only, no pulse, count-ups jump" }
  },

  "dataviz": {
    "bar_height_px":       { "value": 12, "value_type": "game_value" },
    "bar_radius_px":       { "value": 6,  "value_type": "game_value" },
    "marker_width_px":     { "value": 2,  "value_type": "game_value" },
    "gauge_sweep_deg":     { "value": 270, "value_type": "game_value" },
    "gauge_stroke_px":     { "value": 12, "value_type": "game_value" },
    "gantt_row_px":        { "value": 32, "value_type": "game_value" },
    "gantt_radius_px":     { "value": 4,  "value_type": "game_value" },
    "sparkline_px":        { "value": 2,  "value_type": "game_value" },
    "series": { "value": ["signal", "sunlight", "periwinkle", "rose"], "value_type": "game_value", "note": "each series is also told apart by letter or pattern" }
  },

  "icon": {
    "family": { "value": "Lucide", "licence": "ISC", "value_type": "game_value" },
    "stroke_px_at_24": { "value": 2, "value_type": "game_value" },
    "sizes_px": { "value": [24, 32, 48], "value_type": "game_value" }
  }
}
