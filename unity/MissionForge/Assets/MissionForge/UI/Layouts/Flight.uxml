<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="screen" class="mf-screen">
        <ui:VisualElement name="flight-frame" class="mfs-flight__frame" picking-mode="Ignore">
            <ui:VisualElement name="flight-viewport" class="mf-fill" picking-mode="Ignore" />

            <ui:VisualElement name="hud-left" class="mfs-flight__left" picking-mode="Ignore">
                <ui:VisualElement name="phase-panel" class="mf-panel mf-panel--raised mfs-hud">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="MISSION PHASE" />
                        <ui:Label class="mf-panel__tag" text="9.1 PHASES" />
                    </ui:VisualElement>
                    <ui:Label name="phase-name" class="mf-h2" text="—" />
                    <ui:VisualElement class="mfs-flight__clock">
                        <ui:Label class="mf-unit mfs-unit--prefix" text="T+" />
                        <ui:Label name="mission-clock" class="mf-num" text="—" />
                        <ui:Label class="mf-unit" text="min : s" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="telemetry-panel" class="mf-panel mfs-hud">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="TELEMETRY" />
                        <ui:Label class="mf-panel__tag" text="9.6 HUD" />
                    </ui:VisualElement>
                    <ui:VisualElement name="telemetry" class="mf-panel__body">
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="ALTITUDE" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-altitude" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="km" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="VELOCITY" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-velocity" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="m/s" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="DOWNRANGE" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-downrange" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="km" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="ACCELERATION" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-acceleration" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="g" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="DYNAMIC PRESSURE" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-dynamic-pressure" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="kPa" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big mfs-metric--last">
                            <ui:Label class="mfs-metric__name" text="PROPELLANT" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="telemetry-propellant" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="%" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="callout-panel" class="mf-panel mfs-hud mfs-hud--last">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="CALLOUTS" />
                        <ui:Label class="mf-panel__tag" text="9.5 CONSOLES" />
                    </ui:VisualElement>
                    <ui:VisualElement name="callout-feed" class="mf-region mfs-region--tight">
                        <ui:Label class="mf-region__label" text="CAPCOM subtitles · console Good Calls" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hud-centre" class="mfs-flight__centre" picking-mode="Ignore">
                <ui:VisualElement name="phase-strip" class="mf-panel mfs-hud">
                    <ui:VisualElement class="mfs-ticks">
                        <ui:Label name="phase-f1" class="mfs-tick" text="F1" />
                        <ui:Label name="phase-f2" class="mfs-tick" text="F2" />
                        <ui:Label name="phase-f3" class="mfs-tick" text="F3" />
                        <ui:Label name="phase-f4" class="mfs-tick" text="F4" />
                        <ui:Label name="phase-f5" class="mfs-tick" text="F5" />
                        <ui:Label name="phase-f6" class="mfs-tick" text="F6" />
                        <ui:Label name="phase-f7" class="mfs-tick" text="F7" />
                        <ui:Label name="phase-f8" class="mfs-tick" text="F8" />
                        <ui:Label name="phase-f9" class="mfs-tick" text="F9" />
                        <ui:Label name="phase-f10" class="mfs-tick" text="F10" />
                        <ui:Label name="phase-f11" class="mfs-tick" text="F11" />
                        <ui:Label name="phase-f12" class="mfs-tick" text="F12" />
                        <ui:Label name="phase-f13" class="mfs-tick mfs-tick--last" text="F13" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="minigame-banner" class="mfs-banner">
                    <ui:VisualElement class="mf-chip mf-chip--forge">
                        <ui:Label class="mf-chip__label" text="MINIGAME" />
                    </ui:VisualElement>
                    <ui:Label name="minigame-banner-text" class="mf-region__label mfs-banner__text" text="Minigame banner: name · one-line instruction" />
                    <ui:VisualElement class="mfs-banner__timer">
                        <ui:Label name="minigame-banner-timer" class="mf-num mf-num--small" text="—" />
                        <ui:Label class="mf-unit" text="s" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hud-right" class="mfs-flight__right" picking-mode="Ignore">
                <ui:VisualElement name="map-panel" class="mf-panel mfs-hud">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="MAP" />
                        <ui:Label class="mf-panel__tag" text="9.6 MAP VIEW" />
                    </ui:VisualElement>
                    <ui:VisualElement name="map-inset" class="mf-region mfs-flight__map">
                        <ui:Label class="mf-region__label" text="Ground track · orbit · target" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="stage-panel" class="mf-panel mfs-hud">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="STAGE" />
                        <ui:Label class="mf-panel__tag" text="∆v REMAINING" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-panel__body">
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="ACTIVE STAGE" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="stage-active" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="stage" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big">
                            <ui:Label class="mfs-metric__name" text="STAGE ∆v" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="stage-delta-v" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="m/s" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric mfs-metric--big mfs-metric--last">
                            <ui:Label class="mfs-metric__name" text="TOTAL ∆v" />
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="total-delta-v" class="mf-num" text="—" />
                                <ui:Label class="mf-unit" text="m/s" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="boosts-panel" class="mf-panel mfs-hud mfs-hud--last">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="ACTIVE BOOSTS" />
                        <ui:Label class="mf-panel__tag" text="11.1 BOOSTS" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-panel__body">
                        <ui:VisualElement name="boost-icons" class="mf-region mfs-region--tight mfs-gap-bottom-sm">
                            <ui:Label class="mf-region__label" text="Boost icons · shields held" />
                        </ui:VisualElement>
                        <ui:VisualElement name="team-sync" class="mfs-tally mfs-tally--block">
                            <ui:VisualElement class="mfs-tally__head">
                                <ui:Label class="mf-caption" text="TEAM SYNC" />
                                <ui:VisualElement class="mfs-tally__count">
                                    <ui:Label name="team-sync-value" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="/ 100" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-tally__track">
                                <ui:VisualElement name="team-sync-fill" class="mfs-tally__fill" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hud-bottom" class="mfs-flight__bottom" picking-mode="Ignore">
                <ui:VisualElement name="attitude-panel" class="mf-panel mfs-hud mfs-hud--last mfs-flight__attitude">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label class="mf-panel__title" text="ATTITUDE &amp; THROTTLE" />
                        <ui:Label class="mf-panel__tag" text="9.2 PILOT" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mfs-flight__attitude-body">
                        <ui:VisualElement name="navball" class="mfs-navball">
                            <ui:VisualElement class="mfs-navball__horizon" />
                            <ui:VisualElement class="mfs-navball__marker" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-flight__attitude-readouts">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="MODE" />
                                <ui:Label name="attitude-mode" class="mfs-metric__text" text="—" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="PITCH" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="attitude-pitch" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="°" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label class="mf-region__label mfs-gap-top-sm" text="Navball: horizon, prograde and target markers" />
                        </ui:VisualElement>
                        <ui:VisualElement name="throttle" class="mfs-throttle-col">
                            <ui:VisualElement class="mfs-throttle">
                                <ui:VisualElement name="throttle-fill" class="mfs-throttle__fill" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric__value">
                                <ui:Label name="throttle-value" class="mf-num mf-num--small" text="—" />
                                <ui:Label class="mf-unit" text="%" />
                            </ui:VisualElement>
                            <ui:Label class="mfs-th" text="THROTTLE" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
