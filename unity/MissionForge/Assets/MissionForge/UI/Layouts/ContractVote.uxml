<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="screen" class="mf-screen">
        <ui:VisualElement name="kicker" class="mfs-kicker">
            <ui:VisualElement class="mfs-kicker__group">
                <ui:VisualElement class="mfs-kicker__rule" />
                <ui:Label class="mf-h3" text="PRE-PHASE A · MISSION CONCEPT REVIEW" />
                <ui:Label class="mf-caption mfs-kicker__note" text="THE CREW PICKS ONE CONTRACT" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="contract-cards" class="mf-row mf-grow">
            <ui:VisualElement name="contract-card-1" class="mf-panel mfs-contract-card mf-gap-right">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label class="mf-panel__title" text="OPTION A" />
                    <ui:Label class="mf-panel__tag" text="5.1 CONTRACT" />
                </ui:VisualElement>
                <ui:VisualElement class="mf-panel__body">
                    <ui:VisualElement name="contract-1-art" class="mf-region mfs-gap-bottom-sm">
                        <ui:Label class="mf-region__label" text="Destination art · orbit sketch" />
                    </ui:VisualElement>
                    <ui:Label class="mf-caption" text="CONTRACT" />
                    <ui:Label name="contract-1-name" class="mf-h2 mfs-contract-card__title" text="—" />
                    <ui:VisualElement class="mfs-contract-card__facts">
                        <ui:VisualElement name="contract-1-difficulty" class="mf-chip mf-chip--muted">
                            <ui:Label name="contract-1-difficulty-label" class="mf-chip__label" text="DIFFICULTY —" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric__value">
                            <ui:Label class="mfs-metric__name mfs-gap-right-sm" text="REWARD" />
                            <ui:Label name="contract-1-reward" class="mf-num mf-num--small" text="—" />
                            <ui:Label class="mf-unit" text="pts" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="mfs-contract-card__grid">
                        <ui:VisualElement class="mfs-half mfs-half--first">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="PAYLOAD" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-1-payload" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="t" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="BUDGET" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-1-budget" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="$M" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-half">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="∆v NEEDED" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-1-delta-v" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="km/s" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="SCHEDULE" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-1-schedule" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="days" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="contract-1-requirement" class="mf-region mfs-region--fixed">
                        <ui:Label class="mf-region__label" text="Destination · key requirement · special rule" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="contract-card-2" class="mf-panel mfs-contract-card mf-gap-right">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label class="mf-panel__title" text="OPTION B" />
                    <ui:Label class="mf-panel__tag" text="5.1 CONTRACT" />
                </ui:VisualElement>
                <ui:VisualElement class="mf-panel__body">
                    <ui:VisualElement name="contract-2-art" class="mf-region mfs-gap-bottom-sm">
                        <ui:Label class="mf-region__label" text="Destination art · orbit sketch" />
                    </ui:VisualElement>
                    <ui:Label class="mf-caption" text="CONTRACT" />
                    <ui:Label name="contract-2-name" class="mf-h2 mfs-contract-card__title" text="—" />
                    <ui:VisualElement class="mfs-contract-card__facts">
                        <ui:VisualElement name="contract-2-difficulty" class="mf-chip mf-chip--muted">
                            <ui:Label name="contract-2-difficulty-label" class="mf-chip__label" text="DIFFICULTY —" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric__value">
                            <ui:Label class="mfs-metric__name mfs-gap-right-sm" text="REWARD" />
                            <ui:Label name="contract-2-reward" class="mf-num mf-num--small" text="—" />
                            <ui:Label class="mf-unit" text="pts" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="mfs-contract-card__grid">
                        <ui:VisualElement class="mfs-half mfs-half--first">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="PAYLOAD" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-2-payload" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="t" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="BUDGET" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-2-budget" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="$M" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-half">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="∆v NEEDED" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-2-delta-v" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="km/s" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="SCHEDULE" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-2-schedule" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="days" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="contract-2-requirement" class="mf-region mfs-region--fixed">
                        <ui:Label class="mf-region__label" text="Destination · key requirement · special rule" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="contract-card-3" class="mf-panel mfs-contract-card">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label class="mf-panel__title" text="OPTION C" />
                    <ui:Label class="mf-panel__tag" text="5.1 CONTRACT" />
                </ui:VisualElement>
                <ui:VisualElement class="mf-panel__body">
                    <ui:VisualElement name="contract-3-art" class="mf-region mfs-gap-bottom-sm">
                        <ui:Label class="mf-region__label" text="Destination art · orbit sketch" />
                    </ui:VisualElement>
                    <ui:Label class="mf-caption" text="CONTRACT" />
                    <ui:Label name="contract-3-name" class="mf-h2 mfs-contract-card__title" text="—" />
                    <ui:VisualElement class="mfs-contract-card__facts">
                        <ui:VisualElement name="contract-3-difficulty" class="mf-chip mf-chip--muted">
                            <ui:Label name="contract-3-difficulty-label" class="mf-chip__label" text="DIFFICULTY —" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-metric__value">
                            <ui:Label class="mfs-metric__name mfs-gap-right-sm" text="REWARD" />
                            <ui:Label name="contract-3-reward" class="mf-num mf-num--small" text="—" />
                            <ui:Label class="mf-unit" text="pts" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="mfs-contract-card__grid">
                        <ui:VisualElement class="mfs-half mfs-half--first">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="PAYLOAD" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-3-payload" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="t" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="BUDGET" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-3-budget" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="$M" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-half">
                            <ui:VisualElement class="mfs-metric">
                                <ui:Label class="mfs-metric__name" text="∆v NEEDED" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-3-delta-v" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="km/s" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mfs-metric mfs-metric--last">
                                <ui:Label class="mfs-metric__name" text="SCHEDULE" />
                                <ui:VisualElement class="mfs-metric__value">
                                    <ui:Label name="contract-3-schedule" class="mf-num mf-num--small" text="—" />
                                    <ui:Label class="mf-unit" text="days" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="contract-3-requirement" class="mf-region mfs-region--fixed">
                        <ui:Label class="mf-region__label" text="Destination · key requirement · special rule" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="vote-strip" class="mfs-strip">
            <ui:VisualElement name="vote-tally-panel" class="mf-panel mf-panel--raised mf-grow mf-gap-right">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label class="mf-panel__title" text="VOTE TALLY" />
                    <ui:Label class="mf-panel__tag" text="4.1 LIVE TALLY" />
                </ui:VisualElement>
                <ui:VisualElement class="mf-panel__body mf-row">
                    <ui:VisualElement name="tally-1" class="mfs-tally">
                        <ui:VisualElement class="mfs-tally__head">
                            <ui:Label class="mf-caption" text="OPTION A" />
                            <ui:VisualElement class="mfs-tally__count">
                                <ui:Label name="tally-1-votes" class="mf-num mf-num--small" text="—" />
                                <ui:Label class="mf-unit" text="votes" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-tally__track">
                            <ui:VisualElement name="tally-1-fill" class="mfs-tally__fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="tally-2" class="mfs-tally">
                        <ui:VisualElement class="mfs-tally__head">
                            <ui:Label class="mf-caption" text="OPTION B" />
                            <ui:VisualElement class="mfs-tally__count">
                                <ui:Label name="tally-2-votes" class="mf-num mf-num--small" text="—" />
                                <ui:Label class="mf-unit" text="votes" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-tally__track">
                            <ui:VisualElement name="tally-2-fill" class="mfs-tally__fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="tally-3" class="mfs-tally">
                        <ui:VisualElement class="mfs-tally__head">
                            <ui:Label class="mf-caption" text="OPTION C" />
                            <ui:VisualElement class="mfs-tally__count">
                                <ui:Label name="tally-3-votes" class="mf-num mf-num--small" text="—" />
                                <ui:Label class="mf-unit" text="votes" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mfs-tally__track">
                            <ui:VisualElement name="tally-3-fill" class="mfs-tally__fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="mfs-readout mfs-readout--auto mfs-readout--divided">
                        <ui:Label class="mf-caption" text="NOT VOTED" />
                        <ui:VisualElement class="mfs-readout__value">
                            <ui:Label name="tally-abstain" class="mf-num mf-num--small" text="—" />
                            <ui:Label class="mf-unit" text="players" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="vote-timer-panel" class="mf-panel mfs-timer-panel">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label class="mf-panel__title" text="TIMER" />
                    <ui:Label class="mf-panel__tag" text="4.1 VOTE" />
                </ui:VisualElement>
                <ui:VisualElement class="mf-panel__body mf-center">
                    <ui:VisualElement class="mfs-readout__value mfs-readout__value--xl">
                        <ui:Label name="vote-timer" class="mf-num mfs-num--xl" text="—" />
                        <ui:Label class="mf-unit" text="s" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="vote-actions" class="mfs-strip__actions">
                <ui:Button name="btn-start-vote" class="mf-btn mf-btn--primary" text="START VOTE" />
                <ui:Button name="btn-lock-contract" class="mf-btn mf-btn--ghost" text="LOCK CONTRACT" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
