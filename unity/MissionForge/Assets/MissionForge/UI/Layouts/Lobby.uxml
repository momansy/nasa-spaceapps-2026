<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mf="MissionForge.UI">
    <!-- Lobby: crew roster (avatar badge + name + role chip per seat, built by LobbyScreen.cs into crew-grid),
         start control with its enabled/disabled state, room code + QR always visible, host settings. -->
    <ui:VisualElement name="screen" class="mf-screen">
        <ui:VisualElement class="mf-row mf-grow">
            <ui:VisualElement name="crew-panel" class="mf-panel mf-grow mf-gap-right">
                <ui:VisualElement class="mf-panel__header">
                    <ui:Label text="Mission control crew" class="mf-panel__title" />
                    <ui:VisualElement class="mf-row mf-align-end">
                        <ui:Label name="crew-count" text="0" class="mf-lobby__count" />
                        <ui:Label text="/ 10 crew" class="mf-unit mf-roompanel__unit" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="crew-grid" class="mf-crewgrid" />
                <ui:VisualElement class="mf-grow" />
                <ui:VisualElement name="lobby-footer" class="mf-lobby__footer">
                    <ui:Label name="lobby-hint" text="Waiting for the first crew member to join." class="mf-body mf-body--dim mf-lobby__hint" />
                    <ui:Button name="btn-start" text="Start briefing" class="mf-btn mf-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="lobby-side" class="mf-col mf-lobby__side">
                <ui:VisualElement name="join-panel" class="mf-panel mf-panel--raised mf-gap-bottom">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label text="Join this mission" class="mf-panel__title" />
                        <ui:Label text="Scan or type" class="mf-panel__tag" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-row mf-align-center">
                        <ui:VisualElement class="mf-qr mf-qr--compact mf-gap-right">
                            <ui:VisualElement name="qr-image" class="mf-qr__image" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mf-col mf-grow">
                            <ui:Label text="Room code" class="mf-caption" />
                            <ui:Label name="lobby-code" text="----" class="mf-roomcode__value mf-lobby__code" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="join-url" text="" class="mf-joinurl mf-joinurl--small" />
                </ui:VisualElement>

                <ui:VisualElement name="settings-panel" class="mf-panel mf-grow">
                    <ui:VisualElement class="mf-panel__header">
                        <ui:Label text="Mission settings" class="mf-panel__title" />
                        <ui:Label text="HOST" class="mf-panel__tag" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-setting">
                        <ui:Label text="Role assignment" class="mf-setting__label" />
                        <ui:VisualElement name="seg-role-mode" class="mf-segment" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-setting">
                        <ui:Label text="Assist level" class="mf-setting__label" />
                        <ui:VisualElement name="seg-assist" class="mf-segment" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-setting">
                        <ui:Label text="Vote timer" class="mf-setting__label" />
                        <ui:VisualElement name="seg-vote-timer" class="mf-segment" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mf-setting">
                        <ui:Label text="Vote tallies" class="mf-setting__label" />
                        <ui:VisualElement name="seg-tallies" class="mf-segment" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
