<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mf="MissionForge.UI">
    <!-- Persistent chrome: logo, screen title, phase stepper (done / current / locked shapes), room code (hidden until a room exists), connection. -->
    <ui:VisualElement name="chrome" class="mf-chrome" picking-mode="Ignore">
        <ui:VisualElement name="topbar" class="mf-topbar" picking-mode="Ignore">
            <mf:LogoMark name="topbar-logo" style="width: 64px; height: 64px;" />
            <ui:Label name="screen-title" text="" class="mf-topbar__title" />
            <mf:MfPhaseStepper name="stepper" />
            <ui:VisualElement name="room" class="mf-roomcode mf-hidden">
                <ui:Label text="Room" class="mf-roomcode__label" />
                <ui:Label name="room-code" text="" class="mf-roomcode__value" />
            </ui:VisualElement>
            <ui:VisualElement name="conn-chip" class="mf-chip mf-chip--muted mf-topbar__conn">
                <mf:MfIcon name="conn-icon" kind="signal" class="mf-icon--24" />
                <ui:Label name="conn-label" text="Offline" class="mf-chip__label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="veil" class="mf-veil" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
