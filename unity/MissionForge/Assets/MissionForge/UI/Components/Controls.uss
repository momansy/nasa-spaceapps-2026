/* MissionForge controls: button, chip/tag, status badge, segmented control, toggle, text field.
   States: default, :hover, :focus, :active (pressed), :disabled, and --selected/--on where they apply.
   Focus is a 3 px Signal ring drawn as border (USS has no outline); the padding shrinks by the same amount so
   nothing moves. Motion: micro (120 ms) for hover/press, state (200 ms) for selection. Tokens only. */

/* ---------- button: primary, secondary, ghost, danger; sizes L 72, M 56 (default), S 44 ---------- */
.mf-btn {
    -unity-font-definition: var(--mf-font-body-bold);
    font-size: var(--mf-fs-label);
    color: var(--mf-ceramic);
    background-color: var(--mf-console);
    border-width: 1px;
    border-color: var(--mf-ceramic-32);
    border-radius: var(--mf-radius-control);
    padding: 0 var(--mf-sp-5) 0 var(--mf-sp-5);
    margin: 0;
    height: 56px;
    min-width: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: background-color, border-color, translate, scale, opacity, color;
    transition-duration: var(--mf-dur-micro);
    transition-timing-function: ease-out-cubic;
}
.mf-btn--l { height: 72px; font-size: 30px; padding: 0 var(--mf-sp-6) 0 var(--mf-sp-6); border-radius: 12px; }
.mf-btn--m { height: 56px; }
.mf-btn--s { height: 44px; font-size: var(--mf-fs-meta); padding: 0 var(--mf-sp-4) 0 var(--mf-sp-4); }
.mf-btn:hover { background-color: var(--mf-ocean-48); border-color: var(--mf-ceramic-56); translate: 0 -1px; }
.mf-btn:active { background-color: var(--mf-space); translate: 0 1px; scale: 0.98 0.98; }
.mf-btn:focus { border-width: 3px; border-color: var(--mf-signal); padding-left: 22px; padding-right: 22px; }
.mf-btn--l:focus { padding-left: 30px; padding-right: 30px; }
.mf-btn--s:focus { padding-left: 14px; padding-right: 14px; }
.mf-btn:disabled, .mf-btn:disabled:hover, .mf-btn:disabled:active {
    color: var(--mf-muted);
    background-color: var(--mf-console-60);
    border-color: var(--mf-ceramic-10);
    opacity: 0.72;
    translate: 0 0;
    scale: 1 1;
}
.mf-btn__icon { position: absolute; left: 20px; top: 50%; translate: 0 -50%; width: 28px; height: 28px; color: var(--mf-ceramic); }
/* .mf-btn--icon: room for the leading icon (MfButtons.WithIcon); the Button keeps drawing its own text. */
.mf-btn--icon { padding-left: 60px; }
.mf-btn--icon:focus { padding-left: 58px; }
.mf-btn--l.mf-btn--icon { padding-left: 68px; }
.mf-btn--l .mf-btn__icon { left: 26px; width: 32px; height: 32px; }
.mf-rtl .mf-btn--icon { padding-left: var(--mf-sp-5); padding-right: 60px; }
.mf-rtl .mf-btn__icon { left: auto; right: 20px; }

/* Primary: the Ceramic plate (rocket paint on navy) with Space text, 15.8:1. Not Sunlight, which reads as Marginal. */
.mf-btn--primary { color: var(--mf-space); background-color: var(--mf-ceramic); border-color: var(--mf-ceramic); }
.mf-btn--primary .mf-btn__icon { color: var(--mf-space); }
.mf-btn--primary:hover { background-color: #FFFFFF; border-color: #FFFFFF; translate: 0 -2px; }
.mf-btn--primary:active { background-color: var(--mf-muted); border-color: var(--mf-muted); }
.mf-btn--primary:focus { border-color: var(--mf-signal); }
.mf-btn--primary:disabled, .mf-btn--primary:disabled:hover { color: var(--mf-muted); background-color: var(--mf-console); border-color: var(--mf-ceramic-32); }
.mf-btn--primary:disabled .mf-btn__icon { color: var(--mf-muted); }

.mf-btn--secondary { background-color: var(--mf-console-88); border-color: var(--mf-signal-56); }
.mf-btn--secondary:hover { border-color: var(--mf-signal); background-color: var(--mf-ocean-48); }

.mf-btn--ghost { background-color: var(--mf-space-0); border-color: var(--mf-space-0); color: var(--mf-ceramic); -unity-font-definition: var(--mf-font-body-medium); }
.mf-btn--ghost .mf-btn__icon { color: var(--mf-muted); }
.mf-btn--ghost:hover { background-color: var(--mf-ceramic-10); border-color: var(--mf-ceramic-16); }
.mf-btn--ghost:active { background-color: var(--mf-ceramic-06); }

.mf-btn--danger { background-color: var(--mf-fails-16); border-color: var(--mf-fails); color: var(--mf-fails); }
.mf-btn--danger .mf-btn__icon { color: var(--mf-fails); }
.mf-btn--danger:hover { background-color: var(--mf-fails); color: var(--mf-space); }
.mf-btn--danger:hover .mf-btn__icon { color: var(--mf-space); }

/* ---------- chip (identity) and tag (small key) ---------- */
.mf-chip {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 40px;
    padding: 0 var(--mf-sp-4) 0 var(--mf-sp-3);
    border-radius: 20px; /* pill = half the height: UI Toolkit clamps radii per axis, so 999 px draws an ellipse */
    border-width: 1px;
    border-color: var(--mf-ceramic-16);
    background-color: var(--mf-space-60);
}
.mf-chip__label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-ceramic); margin: 0 0 0 var(--mf-sp-2); padding: 0; }
.mf-chip > .mf-icon, .mf-chip > MfIcon { width: 24px; height: 24px; }
.mf-chip--role, .mf-chip--forge { background-color: var(--mf-ocean); border-color: var(--mf-ceramic-32); }
.mf-chip--role .mf-chip__label, .mf-chip--forge .mf-chip__label { -unity-font-definition: var(--mf-font-body-bold); }
.mf-chip--muted .mf-chip__label { color: var(--mf-muted); }
/* Legacy connection chips (status words beside an icon shape): border treatment from the status language. */
.mf-chip--good { border-width: 2px; border-color: var(--mf-meets); }
.mf-chip--good .mf-chip__label { color: var(--mf-meets); }
.mf-chip--warn { border-width: 2px; border-color: var(--mf-marginal); border-radius: var(--mf-radius-control); }
.mf-chip--warn .mf-chip__label { color: var(--mf-marginal); }
.mf-chip--bad { border-width: 3px; border-color: var(--mf-fails); border-radius: 6px; }
.mf-chip--bad .mf-chip__label { color: var(--mf-fails); }
.mf-rtl .mf-chip { flex-direction: row-reverse; }

.mf-tag {
    -unity-font-definition: var(--mf-font-body-bold);
    font-size: var(--mf-fs-meta);
    color: var(--mf-ceramic);
    background-color: var(--mf-ceramic-10);
    border-radius: 6px;
    padding: 2px var(--mf-sp-2) 2px var(--mf-sp-2);
    margin: 0;
    -unity-text-align: middle-center;
}
/* Letter key for options A-J and keyboard hints: a fixed square, series colour optional. */
.mf-tag--key { width: 36px; height: 36px; padding: 0; font-size: var(--mf-fs-label); color: var(--mf-space); background-color: var(--mf-ceramic); border-radius: var(--mf-radius-control); }
.mf-tag--live { color: var(--mf-space); background-color: var(--mf-signal); letter-spacing: 1px; }

/* ---------- status badge: colour + shape (MfIcon meets/marginal/fails) + label + border ----------
   Meets: solid 2 px border, pill.  Marginal: 2 px with a 6 px leading bar, square corners.
   Fails: heavy 3 px border, chamfer-like 4 px corners. Distinct in grayscale. */
.mf-status {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 40px;
    padding: 0 var(--mf-sp-4) 0 var(--mf-sp-2);
    background-color: var(--mf-space-60);
    border-width: 2px;
    border-color: var(--mf-ceramic-32);
    border-radius: var(--mf-radius-control);
}
.mf-status__icon { width: 26px; height: 26px; margin-right: var(--mf-sp-2); }
.mf-status__label { -unity-font-definition: var(--mf-font-body-bold); font-size: var(--mf-fs-label); color: var(--mf-ceramic); margin: 0; padding: 0; }
.mf-status--meets { border-color: var(--mf-meets); border-radius: 20px; color: var(--mf-meets); }
.mf-status--meets .mf-status__label { color: var(--mf-meets); }
.mf-status--marginal { border-color: var(--mf-marginal); border-left-width: 6px; border-radius: 2px; padding-left: 4px; color: var(--mf-marginal); }
.mf-status--marginal .mf-status__label { color: var(--mf-marginal); }
.mf-status--fails { border-width: 3px; border-color: var(--mf-fails); border-radius: 4px; padding-left: 7px; color: var(--mf-fails); }
.mf-status--fails .mf-status__label { color: var(--mf-fails); }
.mf-status--pending { border-color: var(--mf-ceramic-16); color: var(--mf-muted); }
.mf-status--pending .mf-status__label { color: var(--mf-muted); -unity-font-definition: var(--mf-font-body-medium); }
.mf-status--info { border-color: var(--mf-signal-56); color: var(--mf-signal); }
.mf-status--info .mf-status__label { color: var(--mf-ceramic); }
.mf-status--filled.mf-status--meets { background-color: var(--mf-meets); }
.mf-status--filled.mf-status--marginal { background-color: var(--mf-marginal); }
.mf-status--filled.mf-status--fails { background-color: var(--mf-fails); }
.mf-status--filled, .mf-status--filled .mf-status__label { color: var(--mf-space); }
.mf-rtl .mf-status { flex-direction: row-reverse; }

/* ---------- segmented control (legacy name .mf-segment kept as an alias) ---------- */
.mf-segmented, .mf-segment {
    flex-direction: row;
    padding: 4px;
    border-radius: 12px;
    background-color: var(--mf-space-60);
    border-width: 1px;
    border-color: var(--mf-ceramic-10);
}
.mf-segmented__item, .mf-segment__item {
    -unity-font-definition: var(--mf-font-body-medium);
    font-size: var(--mf-fs-label);
    color: var(--mf-muted);
    background-color: var(--mf-space-0);
    border-width: 0;
    border-radius: var(--mf-radius-control);
    margin: 0;
    padding: 0 var(--mf-sp-3) 0 var(--mf-sp-3);
    height: 48px;
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: background-color, color;
    transition-duration: var(--mf-dur-state);
    transition-timing-function: ease-out-cubic;
}
.mf-segmented__item:hover, .mf-segment__item:hover { color: var(--mf-ceramic); background-color: var(--mf-ceramic-06); }
.mf-segmented__item:focus, .mf-segment__item:focus { border-width: 3px; border-color: var(--mf-signal); padding: 0 9px 0 9px; }
.mf-segmented__item:disabled, .mf-segment__item:disabled { opacity: 0.5; }
/* Selected: Ceramic plate with Space text and a heavier face (shape + weight, not hue alone). */
.mf-segmented__item--on, .mf-segment__item--on,
.mf-segmented__item--on:hover, .mf-segment__item--on:hover {
    color: var(--mf-space);
    background-color: var(--mf-ceramic);
    -unity-font-definition: var(--mf-font-body-bold);
}
.mf-rtl .mf-segmented, .mf-rtl .mf-segment { flex-direction: row-reverse; }

/* ---------- toggle: track + knob + label; on = Signal track, knob right, check icon ---------- */
.mf-toggle { flex-direction: row; align-items: center; height: 48px; }
.mf-toggle__track {
    width: 64px; height: 36px;
    border-radius: 18px;
    background-color: var(--mf-space);
    border-width: 2px;
    border-color: var(--mf-ceramic-32);
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: var(--mf-dur-state);
}
.mf-toggle__knob {
    width: 24px; height: 24px;
    border-radius: 12px;
    margin-left: 4px;
    background-color: var(--mf-muted);
    transition-property: translate, background-color;
    transition-duration: var(--mf-dur-state);
    transition-timing-function: ease-out-cubic;
}
.mf-toggle__label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-ceramic); margin: 0 0 0 var(--mf-sp-3); padding: 0; }
.mf-toggle:hover .mf-toggle__track { border-color: var(--mf-ceramic-56); }
.mf-toggle:focus .mf-toggle__track { border-width: 3px; border-color: var(--mf-signal); }
.mf-toggle--on .mf-toggle__track { background-color: var(--mf-signal); border-color: var(--mf-signal); }
.mf-toggle--on .mf-toggle__knob { translate: 28px 0; background-color: var(--mf-space); }
.mf-toggle:disabled { opacity: 0.5; }

/* ---------- text field ---------- */
.mf-field { margin: 0; }
.mf-field__label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); margin: 0 0 var(--mf-sp-2) 0; padding: 0; }
.mf-textfield, .mf-textfield > .unity-text-field__input, .mf-textfield .unity-base-text-field__input {
    -unity-font-definition: var(--mf-font-body);
    font-size: var(--mf-fs-label);
    color: var(--mf-ceramic);
}
.mf-textfield { margin: 0; }
.mf-textfield > .unity-base-text-field__input, .mf-textfield .unity-base-field__input {
    height: 56px;
    padding: 0 var(--mf-sp-4) 0 var(--mf-sp-4);
    background-color: var(--mf-space);
    border-width: 1px;
    border-color: var(--mf-ceramic-32);
    border-radius: var(--mf-radius-control);
}
.mf-textfield:hover .unity-base-field__input { border-color: var(--mf-ceramic-56); }
.mf-textfield:focus .unity-base-field__input { border-width: 3px; border-color: var(--mf-signal); padding: 0 14px 0 14px; }
.mf-textfield--invalid .unity-base-field__input { border-width: 3px; border-color: var(--mf-fails); padding: 0 14px 0 14px; }
.mf-field__error { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-fails); margin: var(--mf-sp-2) 0 0 0; padding: 0; }

/* ---------- 200 % text: fixed-height pills, badges and keys grow with their label instead of clipping ---------- */
.mf-text-200 .mf-chip, .mf-text-200 .mf-status { height: auto; min-height: 40px; padding-top: 6px; padding-bottom: 6px; }
.mf-text-200 .mf-tag--key { width: 60px; height: 60px; }
.mf-text-200 .mf-btn { height: auto; min-height: 56px; padding-top: 8px; padding-bottom: 8px; }
