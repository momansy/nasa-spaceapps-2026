/* Seat and avatar card (MfSeatCard) and the room-code / QR join block shared by Title and Lobby. */

.mf-seat {
    width: 192px;
    height: 264px;
    padding: var(--mf-sp-5) var(--mf-sp-3) var(--mf-sp-4) var(--mf-sp-3);
    align-items: center;
    background-color: var(--mf-space-40);
    border-width: 1px;
    border-color: var(--mf-ceramic-10);
    border-radius: var(--mf-radius-card);
    opacity: 1;
    transition-property: opacity, translate, scale, background-color;
    transition-duration: var(--mf-dur-enter);
    transition-timing-function: ease-out-cubic;
}
.mf-seat--enter { opacity: 0; translate: 0 16px; scale: 0.96 0.96; }
/* USS ease-out-back overshoots ~10 % (token: <= 6 %), so the USS path uses ease-out-cubic; MfMotion.Celebrate has the exact curve. */
.mf-seat--celebrate { transition-duration: var(--mf-dur-celebrate); transition-timing-function: ease-out-cubic; }
.mf-seat__avatar { width: 112px; height: 112px; margin-bottom: var(--mf-sp-4); align-items: center; justify-content: center; flex-shrink: 0; }
.mf-seat__waiting-icon { width: 40px; height: 40px; color: var(--mf-muted); }
.mf-seat__name { -unity-font-definition: var(--mf-font-body-bold); font-size: 28px; color: var(--mf-ceramic); margin: 0 0 var(--mf-sp-3) 0; padding: 0; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 168px; }
.mf-seat__role { align-self: center; max-width: 184px; }
.mf-seat__role .mf-chip__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--mf-fs-meta); }
.mf-seat__waiting { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); margin: 0; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.mf-seat--empty { background-color: var(--mf-space-0); border-color: var(--mf-ceramic-10); }
.mf-seat--away { opacity: 0.6; }
.mf-hc .mf-seat { background-color: var(--mf-console); border-width: 2px; border-color: var(--mf-ceramic-56); }
.mf-hc .mf-seat__waiting, .mf-hc .mf-seat__waiting-icon { color: var(--mf-ceramic); }
.mf-hc .mf-seat--away { opacity: 1; }
.mf-text-200 .mf-seat { height: 340px; }
.mf-text-200 .mf-seat__name { font-size: 48px; max-width: 100%; }
.mf-text-200 .mf-seat__role { max-width: 100%; }

/* ---------- join block: large tabular room code + QR on a white card ---------- */
.mf-join { flex-direction: row; align-items: center; }
.mf-rtl .mf-join { flex-direction: row-reverse; }
.mf-qrcard { width: 220px; height: 220px; padding: 14px; background-color: var(--mf-qr-light); border-radius: var(--mf-radius-card); flex-shrink: 0; }
.mf-qrcard--s { width: 184px; height: 184px; padding: 12px; }
.mf-qrcard__image { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.mf-join__text { flex-grow: 1; flex-shrink: 1; margin-left: var(--mf-sp-6); }
.mf-rtl .mf-join__text { margin-left: 0; margin-right: var(--mf-sp-6); }
.mf-roomcode-big { -unity-font-definition: var(--mf-font-mono-bold); font-size: 104px; letter-spacing: 8px; color: var(--mf-ceramic); margin: 0; padding: 0; }
.mf-roomcode-big--empty { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); letter-spacing: 0; color: var(--mf-muted); white-space: normal; }
.mf-joinurl { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-meta); color: var(--mf-signal); white-space: normal; margin: var(--mf-sp-2) 0 0 0; padding: 0; }
.mf-text-200 .mf-roomcode-big { font-size: 120px; }

/* Legacy QR classes (other screens). */
.mf-qr { width: 236px; height: 236px; background-color: var(--mf-qr-light); border-radius: var(--mf-radius-card); padding: 14px; flex-shrink: 0; }
.mf-qr--compact { width: 172px; height: 172px; padding: 10px; }
.mf-qr__image { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.mf-codecells { flex-direction: row; justify-content: space-between; margin: var(--mf-sp-2) 0 var(--mf-sp-5) 0; }
.mf-codecell { width: 124px; height: 140px; align-items: center; justify-content: center; background-color: var(--mf-space); border-width: 1px; border-color: var(--mf-ceramic-16); border-radius: var(--mf-radius-card); }
.mf-codecell__char { -unity-font-definition: var(--mf-font-mono-bold); font-size: 96px; color: var(--mf-ceramic); margin: 0; padding: 0; -unity-text-align: middle-center; }
.mf-lobby__count { -unity-font-definition: var(--mf-font-body-bold); font-size: 44px; color: var(--mf-ceramic); margin: 0; padding: 0; }
.mf-roompanel__unit { margin-bottom: 8px; }
.mf-setting { margin-bottom: var(--mf-sp-5); }
.mf-setting__label { -unity-font-definition: var(--mf-font-body-medium); font-size: var(--mf-fs-label); color: var(--mf-muted); margin: 0 0 var(--mf-sp-2) 0; padding: 0; }
