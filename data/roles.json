{
  "$schema": "./schema/role.schema.json",
  "design_notes": [
    "The design does not map roles to part categories, so no role lists categories yet.",
    "Ability magnitudes are stored as effects where the design gives a number; \"+N%\" on a quantity is a relative change (add_fraction), \"halves\" and \"doubles\" are multipliers. Abilities without a number carry flags only.",
    "Merging below five players is shown only by example in Appendix A (four players: the fourth holds EECOM+INCO+PAYLOAD+RETRO)."
  ],
  "assignment_modes": [
    "random",
    "player_pick",
    "vote"
  ],
  "default_assignment_mode": "random",
  "merge_order": [
    [
      "FLIGHT",
      "PM"
    ],
    [
      "BOOSTER",
      "STRUCT"
    ],
    [
      "GUIDO",
      "FIDO"
    ],
    [
      "EECOM",
      "INCO"
    ],
    [
      "PAYLOAD",
      "RETRO"
    ]
  ],
  "roles": [
    {
      "id": "FLIGHT",
      "name_key": "role.FLIGHT.name",
      "origin_key": "role.FLIGHT.origin",
      "insight_key": "role.FLIGHT.insight",
      "console_key": "role.FLIGHT.console",
      "ability": {
        "id": "decision_time",
        "name_key": "role.FLIGHT.ability.name",
        "description_key": "role.FLIGHT.ability.description",
        "flags": [
          "ends_stalled_vote",
          "breaks_ties"
        ]
      }
    },
    {
      "id": "BOOSTER",
      "name_key": "role.BOOSTER.name",
      "origin_key": "role.BOOSTER.origin",
      "insight_key": "role.BOOSTER.insight",
      "console_key": "role.BOOSTER.console",
      "ability": {
        "id": "hot_fire_discount",
        "name_key": "role.BOOSTER.ability.name",
        "description_key": "role.BOOSTER.ability.description",
        "effects": [
          {
            "target": "test_cost_M",
            "op": "add_fraction",
            "value": -0.5,
            "scope": "next_engine_test"
          }
        ]
      }
    },
    {
