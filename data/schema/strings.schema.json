{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strings.schema.json",
  "title": "MissionForge strings",
  "description": "data/strings/<lang>.json: flat map from string key to player-visible text. en.json is the reference language.",
  "x-data-files": [
    "strings/*.json"
  ],
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$": {
      "type": "string",
      "minLength": 1,
      "description": "The text shown to players."
    }
  }
}
