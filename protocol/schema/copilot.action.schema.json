{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:missionforge:protocol:v1:copilot.action",
  "title": "copilot.action",
  "description": "client → server → host (relayed inside `relay`). The co-pilot stages or deploys from their phone while the pilot flies. The co-pilot seat always reads from the phone.",
  "type": "object",
  "properties": {
    "n": {
      "description": "Action counter, increasing; the host ignores duplicates.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "action": {
      "description": "STAGE or DEPLOY.",
      "$ref": "#/$defs/CopilotAction"
    },
    "deploy": {
      "description": "Required when `action` = DEPLOY.",
      "$ref": "#/$defs/DeployTarget"
    }
  },
  "required": [
    "n",
    "action"
  ],
  "additionalProperties": false,
  "$defs": {
    "CopilotAction": {
      "description": "Co-pilot action (§9.4).",
      "type": "string",
      "enum": [
        "STAGE",
        "DEPLOY"
      ]
    },
    "DeployTarget": {
      "description": "What to deploy (§9.2).",
      "type": "string",
      "enum": [
        "CONTEXT",
        "FAIRING",
        "CHUTES",
        "LEGS",
        "ARRAYS"
      ]
    }
  },
  "examples": [
    {
      "n": 3,
      "action": "DEPLOY",
      "deploy": "FAIRING"
    }
  ]
}
