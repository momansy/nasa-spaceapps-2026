{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:missionforge:protocol:v1:room.state",
  "title": "room.state",
  "description": "server → host and clients. Full membership snapshot. Sent in every snapshot and broadcast after any change to it: join, leave, kick, disconnect, reconnect, slot expiry, promotion, profile or preference change, veto use, pause change, host connect/disconnect. Roles are in roles.state, the phase in phase.set.",
  "type": "object",
  "properties": {
    "room": {
      "description": "Room code.",
      "$ref": "#/$defs/RoomCode"
    },
    "hostConnected": {
      "description": "False while the host is away (the game is then paused).",
      "type": "boolean"
    },
    "paused": {
      "description": "True while the game is paused for any reason.",
      "type": "boolean"
    },
    "players": {
      "description": "Players ordered by `slot`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlayerInfo"
      },
      "minItems": 0,
      "maxItems": 10
    },
    "spectatorCount": {
      "description": "Connected spectators, including pending players.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "pendingPlayerCount": {
      "description": "Spectators waiting to be promoted to player.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "room",
    "hostConnected",
    "paused",
    "players",
    "spectatorCount",
    "pendingPlayerCount"
  ],
  "additionalProperties": false,
  "$defs": {
    "Avatar": {
      "description": "Player avatar (§3.1): astronaut suit colour and patch, both cosmetic ids.",
      "type": "object",
      "properties": {
        "suitId": {
          "description": "Suit colour cosmetic id, e.g. \"suit_orange\".",
          "$ref": "#/$defs/DataId"
        },
        "patchId": {
          "description": "Patch cosmetic id, e.g. \"patch_comet\".",
          "$ref": "#/$defs/DataId"
        }
      },
      "required": [
        "suitId",
        "patchId"
      ],
      "additionalProperties": false
    },
    "DataId": {
      "description": "Identifier of an entry in the shared game data (`data/`): part, part category, contract, test, anomaly card, minigame, fact, codex entry, callout, console request, award, objective, validation rule, cosmetic. 1–48 characters.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,47}$"
    },
    "LangTag": {
      "description": "BCP 47 language tag, lower-case primary subtag (e.g. \"en\", \"ar\", \"pt-BR\").",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$"
    },
    "Nickname": {
      "description": "Display nickname after server normalisation (NFC, trimmed, inner whitespace collapsed): 2–16 characters; Unicode letters, digits, space, underscore and hyphen; first and last character must be a letter or digit.",
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} _-]{0,14}[\\p{L}\\p{N}]$"
    },
    "PlayerId": {
      "description": "Player identifier, unique within a room and never reused: \"p\" followed by a positive integer (p1, p2, …).",
      "type": "string",
      "pattern": "^p[1-9][0-9]{0,3}$"
    },
    "PlayerInfo": {
      "description": "One player slot in `room.state`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Player id.",
          "$ref": "#/$defs/PlayerId"
        },
        "slot": {
          "description": "Seat number 1–10 (display order; the lowest free seat is assigned at join).",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "nickname": {
          "description": "Display nickname.",
          "$ref": "#/$defs/Nickname"
        },
        "avatar": {
          "description": "Avatar.",
          "$ref": "#/$defs/Avatar"
        },
        "connected": {
          "description": "False while the player is disconnected and the slot is being held.",
          "type": "boolean"
        },
        "slotExpiresAtMs": {
          "description": "When the held slot is released (server clock); null while connected. Frozen while the game is paused.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "vetoAvailable": {
          "description": "True until the player uses the one veto of this mission (§4.2).",
          "type": "boolean"
        },
        "prefs": {
          "description": "Accessibility and language preferences of the device.",
          "$ref": "#/$defs/PlayerPrefs"
        }
      },
      "required": [
        "id",
        "slot",
        "nickname",
        "avatar",
        "connected",
        "slotExpiresAtMs",
        "vetoAvailable",
        "prefs"
      ],
      "additionalProperties": false
    },
    "PlayerPrefs": {
      "description": "Per-device accessibility and language preferences (§16). Set by each phone, relayed to the host and all clients inside `room.state`.",
      "type": "object",
      "properties": {
        "lang": {
          "description": "UI language of this device.",
          "$ref": "#/$defs/LangTag"
        },
        "relaxed": {
          "description": "Motor: Relaxed minigame mode (wider timing windows).",
          "type": "boolean"
        },
        "oneButton": {
          "description": "Motor: One-Button minigame alternative.",
          "type": "boolean"
        },
        "holdToToggle": {
          "description": "Motor: hold-to-press controls become toggles.",
          "type": "boolean"
        },
        "reducedMotion": {
          "description": "Motion: no shake, fewer particles, no flashing.",
          "type": "boolean"
        },
        "highContrast": {
          "description": "Visual: high-contrast mode.",
          "type": "boolean"
        },
        "textScalePct": {
          "description": "Visual: text scale in percent (100–200).",
          "type": "integer",
          "minimum": 100,
          "maximum": 200
        },
        "screenReader": {
          "description": "Visual: screen-reader labels requested.",
          "type": "boolean"
        },
        "haptics": {
          "description": "Whether the device wants `haptic.cue` vibrations.",
          "type": "boolean"
        }
      },
      "required": [
        "lang",
        "relaxed",
        "oneButton",
        "holdToToggle",
        "reducedMotion",
        "highContrast",
        "textScalePct",
        "screenReader",
        "haptics"
      ],
      "additionalProperties": false
    },
    "RoomCode": {
      "description": "Room code: exactly 4 upper-case letters from A–Z without I and O (24-letter alphabet). Clients upper-case user input before sending.",
      "type": "string",
      "pattern": "^[A-HJ-NP-Z]{4}$"
    },
    "TimeMs": {
      "description": "Absolute time on the server clock: integer milliseconds since the Unix epoch. Every `…AtMs` field in the protocol uses the server clock (see Clock).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "examples": [
    {
      "room": "KQXM",
      "hostConnected": true,
      "paused": false,
      "players": [
        {
          "id": "p1",
          "slot": 1,
          "nickname": "Ada",
          "avatar": {
            "suitId": "suit_white",
            "patchId": "patch_orbit"
          },
          "connected": true,
          "slotExpiresAtMs": null,
          "vetoAvailable": true,
          "prefs": {
            "lang": "en",
            "relaxed": false,
            "oneButton": false,
            "holdToToggle": false,
            "reducedMotion": false,
            "highContrast": false,
            "textScalePct": 100,
            "screenReader": false,
            "haptics": true
          }
        },
        {
          "id": "p3",
          "slot": 3,
          "nickname": "Nova",
          "avatar": {
            "suitId": "suit_orange",
            "patchId": "patch_comet"
          },
          "connected": false,
          "slotExpiresAtMs": 1794650180000,
          "vetoAvailable": false,
          "prefs": {
            "lang": "en",
            "relaxed": false,
            "oneButton": false,
            "holdToToggle": false,
            "reducedMotion": false,
            "highContrast": false,
            "textScalePct": 100,
            "screenReader": false,
            "haptics": true
          }
        }
      ],
      "spectatorCount": 4,
      "pendingPlayerCount": 1
    }
  ]
}
