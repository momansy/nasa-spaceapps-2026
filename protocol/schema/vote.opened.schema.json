      ],
      "hint": null,
      "predict": {
        "id": "pq_vacuum_isp",
        "prompt": {
          "key": "predict.most_efficient_vacuum"
        },
        "choices": [
          {
            "key": "part.eng_kerolox_workhorse.name"
          },
          {
            "key": "part.eng_electric_mini.name"
          },
          {
            "key": "part.eng_methalox_reusable.name"
          }
        ]
      },
      "voters": [
        "p1",
        "p2",
        "p3",
        "p4"
      ],
      "solo": false,
      "vetoAllowed": true,
      "tagsAllowed": true,
      "strictMajority": false,
      "tallyVisibility": "OPEN",
