              "value": 1.31,
              "delta": 1.31,
              "rating": "GOOD"
            },
            {
              "metric": "COST_M",
              "value": 52.4,
              "delta": 10.8,
              "rating": "NEUTRAL"
            },
            {
              "metric": "SCHEDULE_DAYS",
              "value": 98,
              "delta": 2,
              "rating": "NEUTRAL"
            }
          ]
        },
        {
          "id": "eng_electric_mini",
          "partId": "eng_electric_mini",
          "label": null,
          "costM": 6.3,
          "afford": "OK",
          "overBudgetByM": 0,
          "overScheduleByDays": 0,
          "willNotFly": true,
          "fixExists": false,
          "warnings": [
            {
              "key": "rule.twr_below_one"
            }
          ],
          "deltas": [
            {
              "metric": "LIFTOFF_TWR",
              "value": 0.74,
              "delta": 0.74,
              "rating": "BAD"
            }
          ]
        },
        {
          "id": "eng_methalox_reusable",
          "partId": "eng_methalox_reusable",
          "label": null,
          "costM": 44.1,
          "afford": "EMERGENCY_FUNDING",
          "overBudgetByM": 3.5,
