<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the Unity package sources in ../Runtime with the .NET SDK, so Core can be compiled and tested without Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MissionForge.Core</AssemblyName>
    <RootNamespace>MissionForge.Core</RootNamespace>
    <!-- The sources live outside this folder, and Tests/ lives inside it: turn the default globs off. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
